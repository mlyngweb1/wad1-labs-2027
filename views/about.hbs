{{> menu id = "about"}}

<section class="ui center aligned middle aligned segment">
    <h2>About the Playlist App!</h2>

    <div class="ui centered link cards">

        {{#each info.creators}}

        <div class="ui card">
            <div class="image">
                <img src="{{image}}">
            </div>
            <div class="content">
                <a class="header"> {{fullname}}</a>
                <div class="meta">
                    <span class="date">Joined in {{joined}}</span>
                </div>
                <div class="description">
                    {{name}} is a
                    {{job}}.
                </div>
            </div>
        </div>
        {{/each}}


    </div>


</section>