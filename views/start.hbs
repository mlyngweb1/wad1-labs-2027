{{> menu}}

<section class="ui center aligned middle aligned segment">
    <h2>Welcome to the Playlist App!</h2>
    <p>
        This app will allow users to create and maintain a collection of playlists.
    </p>
    <img src="images/wallpaper.jpg" class="ui centered image">

   <div class="ui three statistics" style="margin-top: 1em;">
    {{#with info}}
        <div class="statistic">
            <div class="value">
                <i class="music icon"></i>
            </div>
            <div class="label">
                App Title: <br>
                {{appTitle}}
            </div>
        </div>

        <div class="statistic">
            <div class="value">
                <i class="code branch icon"></i>
            </div>
            <div class="label">
                App Version: <br>
                Version {{version}}
            </div>
        </div>
        <div class="statistic">
            <div class="value">
                <i class="map pin icon"></i>
            </div>
            <div class="label">
                Made in: <br>
                {{location}}
            </div>
        </div>
    {{/with}}
</div>


</section>


